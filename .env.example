# ==============================================================================
# PIRATE WARS - Environment Configuration
# ==============================================================================

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=

# Database Settings
# Supports local MongoDB, MongoDB Atlas URI, or mock mode for testing
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pirate_wars
USE_MOCK_DB=false

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-3-flash-preview
GEMINI_MODEL_REASONING=gemini-3-pro-preview

# Simulation & Game Parameters
WORLD_TICK_INTERVAL_SECONDS=60
SIMULATION_POPULATION_AI_PIRATES=50
SIMULATION_POPULATION_AI_MARINES=70
SIMULATION_POPULATION_AI_MERCHANTS=40
SIMULATION_POPULATION_AI_CIVILIANS=300

# Logging & Debug
LOG_LEVEL=INFO
DEBUG_MODE=false
